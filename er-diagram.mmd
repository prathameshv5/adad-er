erDiagram

    %% =========================
    %% USER & ROLE STRUCTURE
    %% =========================

    User {
        int user_id PK
        int role_id FK
        string name
        string email
        string phone
        string password_hash
        string gender
        date date_of_birth
        string address
        string status
        datetime created_at
        datetime updated_at
    }

    Role {
        int role_id PK
        string role_name
        string description
        datetime created_at
        datetime updated_at
    }

    VendorDetails {
        int vendor_id PK, FK
        string company_name
        string company_type
        string gst_number
        string pan
        string address
        string website
        string business_license_document
        string profile_status
        string rejection_reason
        int approved_by_admin_id FK
        datetime approved_at
        datetime created_at
        datetime updated_at
    }

    PwDDetails {
        int pwd_id PK, FK
        int disability_percentage
        string udid_number
        string udid_document
        string support_needed
        string guardian_name
        string address
        datetime created_at
        datetime updated_at
    }

    CaregiverDetails {
        int caregiver_id PK, FK
        int pwd_id FK
        string relationship_type
        datetime created_at
        datetime updated_at
    }

    EmployerDetails {
        int employer_id PK, FK
        string organization_name
        string organization_type
        string contact_person
        string designation
        string website
        string address
        string registration_document
        string profile_status
        datetime created_at
        datetime updated_at
    }

    DonorDetails {
        int donor_id PK, FK
        string full_name_or_organization_name
        string donor_type
        string address
        string id_proof_document
        string donation_preference
        datetime created_at
        datetime updated_at
    }

    AdminDetails {
        int admin_id PK, FK
        string designation
        string department
        string access_level
        datetime created_at
        datetime updated_at
    }

    %% =========================
    %% DISABILITY & PRODUCT STRUCTURE
    %% =========================

    Disability {
        int disability_id PK
        string name
        string description
    }

    DisabilitySubCategory {
        int subcategory_id PK
        int disability_id FK
        string name
        string description
    }

    Product {
        int product_id PK
        int vendor_id FK
        int parent_product_id FK
        string name
        string description
        float price
        string specifications
        string demo_video_url
        string stock_status
        string listing_status
        string website_status
        string rejection_reason
        int approved_by_admin_id FK
        datetime approved_at
        boolean is_current_version
        int version_number
        datetime created_at
        datetime updated_at
    }

    PwDDisability {
        int pwd_disability_id PK
        int pwd_id FK
        int disability_id FK
        datetime created_at
    }

    ProductDisabilitySubCategory {
        int product_subcategory_id PK
        int product_id FK
        int subcategory_id FK
        datetime created_at
    }

    ProductMedia {
        int media_id PK
        int product_id FK
        string media_type
        string url
        datetime created_at
    }

    %% =========================
    %% INTERACTIONS
    %% =========================

    ProductInterest {
        int interest_id PK
        int product_id FK
        int pwd_id FK
        string note
        datetime created_at
    }

    ProductReview {
        int review_id PK
        int product_id FK
        int pwd_id FK
        int rating
        string review_text
        string status
        string ai_moderation_result
        string ai_flag_reason
        string rejection_reason
        int moderated_by_admin_id FK
        datetime ai_moderated_at
        datetime admin_moderated_at
        datetime created_at
        datetime updated_at
    }

    ReviewReply {
        int reply_id PK
        int review_id FK
        int user_id FK
        string reply_text
        string status
        string rejection_reason
        int moderated_by_admin_id FK
        datetime admin_moderated_at
        datetime created_at
        datetime updated_at
    }

    %% =========================
    %% NOTIFICATIONS
    %% =========================

    Notification {
        int notification_id PK
        int user_id FK
        string title
        string message
        string related_entity_type
        int related_entity_id
        boolean is_read
        datetime created_at
    }

    %% =========================
    %% HELP SECTION
    %% =========================

    HelpCategory {
        int help_category_id PK
        string name
        string description
        datetime created_at
        datetime updated_at
    }

    HelpArticle {
        int article_id PK
        int help_category_id FK
        int created_by_admin_id FK
        int role_id FK
        string title
        string content
        string attachments
        string status
        datetime created_at
        datetime updated_at
    }

    FAQ {
        int faq_id PK
        int help_category_id FK
        int created_by_admin_id FK
        int role_id FK
        string question
        string answer
        int display_order
        string status
        datetime created_at
        datetime updated_at
    }

    %% =========================
    %% MODERATION SYSTEM
    %% =========================

    AIModeration {
        int ai_moderation_id PK
        int review_id FK
        string moderation_result
        string flag_reason
        float confidence_score
        datetime moderated_at
    }

    %% =========================
    %% STORY SECTION
    %% =========================

    Story {
        int story_id PK
        int admin_id FK
        string title
        string content
        string image_url
        string status
        datetime created_at
        datetime updated_at
    }

    StoryLike {
        int like_id PK
        int story_id FK
        int pwd_id FK
        datetime created_at
    }

    %% =========================
    %% DONOR PLEDGE SYSTEM
    %% =========================

    ProductPledge {
        int pledge_id PK
        int product_id FK
        int donor_id FK
        int quantity
        float pledge_amount
        string pledge_note
        string status
        string fulfillment_note
        int updated_by_admin_id FK
        datetime status_updated_at
        datetime created_at
        datetime updated_at
    }

    %% =========================
    %% RELATIONSHIPS
    %% =========================

