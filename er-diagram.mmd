    ReviewReply }o--|| AdminDetails : "moderated_by_admin_id"
    
    CaregiverDetails }o--|| PwDDetails : "pwd_id"
    Product }o--|| Product : "parent_product_id"
    User ||--o{ Notification : "user_id"

    User ||--o{ ReviewReply : "user_id"
    
    VendorDetails ||--o{ Notification : "receives"
    PwDDetails ||--o{ Notification : "receives"
    DonorDetails ||--o{ Notification : "receives"
    EmployerDetails ||--o{ Notification : "receives"
    AdminDetails ||--o{ Notification : "receives"

    HelpCategory ||--o{ HelpArticle : "has articles"
    HelpCategory ||--o{ FAQ : "has faqs"
    AdminDetails ||--o{ HelpArticle : "admin creates articles"
    AdminDetails ||--o{ FAQ : "admin creates faqs"

    HelpArticle }o--|| Role : "role_id"
    FAQ }o--|| Role : "role_id"
    HelpArticle }o--|| AdminDetails : "created_by_admin_id"
    FAQ }o--|| AdminDetails : "created_by_admin_id"

    ProductReview ||--|| AIModeration : "ai moderates"
    AIModeration }o--|| ProductReview : "review_id"
    
    AdminDetails ||--o{ Story : "admin creates"
    Story ||--o{ StoryLike : "liked by PwD"
    PwDDetails ||--o{ StoryLike : "PwD likes"

    DonorDetails ||--o{ ProductPledge : "donor pledges"
    Product ||--o{ ProductPledge : "receives pledges"
    ProductPledge }o--|| DonorDetails : "donor_id"

    ProductPledge }o--|| AdminDetails : "updated_by_admin_id"